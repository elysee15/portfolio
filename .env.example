# GitHub GraphQL API — home « Activité » contribution calendar.
# Classic PAT with the `read:user` scope. Optional: without it the section
# renders a notice instead of the graph and the build still passes.
GITHUB_TOKEN=

# Production origin, no trailing slash — e.g. https://elyseebleu.com
# Canonical links, Open Graph URLs, the sitemap and JSON-LD are built from it.
# Optional on Vercel, which provides VERCEL_PROJECT_PRODUCTION_URL; without
# either, the build emits http://localhost:3000 rather than guessing a domain.
NEXT_PUBLIC_SITE_URL=
